# Astro frontend (web/) — see web/.env.example for local development
PREVIEW_SECRET=change-me-to-a-random-string
# Internal Docker network URL for the CMS
PAYLOAD_URL=http://cms:4201
# Public URL where the CMS is reachable from the browser. Must exactly match
# the CMS origin, including https:// when applicable. Empty = proxy mode:
# browser CMS calls go to same-origin /api/* and the Astro server proxies
# them to the internal CMS container.
PUBLIC_PAYLOAD_URL=
# API key generated from a CMS user (needed for draft preview)
PAYLOAD_API_KEY=
# (Optional) Google Analytics measurement ID
PUBLIC_GTAG_ID=
