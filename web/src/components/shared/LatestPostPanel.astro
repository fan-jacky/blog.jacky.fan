---
// Ported from components/LatestPostPanel.vue (Nuxt → Astro).
// The Vue version fetched /api/payload-posts?limit=3 at runtime; here the same
// data (3 latest published posts as summaries) is fetched at build time.
import type { PayloadPostSummary } from '@/types/payload'
import { fetchPayloadPosts, toPayloadPostSummary } from '@/lib/payload'
import { buildArticlePath, formatPayloadDate } from '@/lib/payloadPost'
import NewsPaperIcon from '@/components/shared/icons/NewsPaperIcon.astro'

let posts: PayloadPostSummary[] = []

try {
  posts = (await fetchPayloadPosts({ depth: 1, limit: 3 })).map(toPayloadPostSummary)
} catch {
  posts = []
}
---
<div class="bg-base-100 rounded-2xl shadow-md my-4 px-8 py-8 hidden lg:block">
  <div class="prose">
    <h4 class="text-xl">
      <NewsPaperIcon className="h-[1.2em] mb-1 inline" /> Latest Articles
    </h4>
    <div class="divide-y">
      {posts.length ? (
        <div>
          {posts.map((article) => (
            <div class="py-2">
              <a href={buildArticlePath(article.slug)} class="mb-0 no-underline hover:text-blue-500 transition-all">{article.title}</a>
              <br />{formatPayloadDate(article.publishedDate)}
            </div>
          ))}
        </div>
      ) : (
        <div>No Article Recently.</div>
      )}
    </div>
  </div>
</div>
