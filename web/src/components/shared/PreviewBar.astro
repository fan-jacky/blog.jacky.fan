---
// Ported from components/PreviewBar.vue (Nuxt → Astro).
// No Teleport and no SSR cookie access in a static build: the banner markup is
// always rendered (hidden inline) and revealed client-side when the
// `payload-preview=1` cookie is present.
---
<div class="preview-banner" style="display: none;">
  <span class="preview-banner__text">Preview mode — this content may not be published yet.</span>
  <a
    href="/api/disable-preview"
    class="preview-banner__action"
  >
    Exit Preview
  </a>
</div>

<script>
  function hasPayloadPreviewCookie(): boolean {
    return document.cookie.split(/;\s*/).some((cookie) => cookie === 'payload-preview=1')
  }

  const banner = document.querySelector<HTMLElement>('.preview-banner')

  if (banner && hasPayloadPreviewCookie()) {
    banner.style.display = ''
  }
</script>
