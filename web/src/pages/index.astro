---
import Base from '@/layouts/Base.astro'
import NavBar from '@/components/shared/NavBar.astro'
import Footer from '@/components/shared/Footer.astro'
import type { PayloadPostSummary } from '@/types/payload'
import {
  buildArticlePath,
  formatPayloadDate,
  getPrimaryPayloadTag,
  resolvePayloadMediaAlt,
  resolvePayloadMediaUrl,
} from '@/lib/payloadPost'
import {
  fetchPayloadPostsForBuild,
  fetchPayloadSiteSettings,
  getPayloadConnection,
  toPayloadPostSummary,
} from '@/lib/payload'

// Mirrors /api/payload-posts (depth 1, published only, sorted -publishedDate).
const posts = (await fetchPayloadPostsForBuild({ depth: 1 })).map(toPayloadPostSummary)

// Mirrors /api/globals/site_settings via /api/payload-site-settings.
const settings = await fetchPayloadSiteSettings()

const homeAbout = settings?.homeAbout ?? null

const featuredArticle: PayloadPostSummary | null = posts[0] ?? null
const recentArticles = posts.slice(0, 6)

// Media URLs are relative to the CMS origin when stored as relative paths.
// The public origin wins so browser-reachable URLs are emitted (same
// precedence as the Nuxt version: public.payloadUrl || payloadUrl).
const cmsBaseUrl = import.meta.env.PUBLIC_PAYLOAD_URL || getPayloadConnection().payloadURL

function getFeaturedImageUrl(article: PayloadPostSummary): string {
  return resolvePayloadMediaUrl(article.featuredImage, cmsBaseUrl)
}

function getFeaturedImageAlt(article: PayloadPostSummary): string {
  return resolvePayloadMediaAlt(article.title, article.featuredImage)
}
---

<Base
  title="Jacky FAN's Blog - A Personal Blog by Jacky FAN"
  description="Welcome to Jacky FAN's Blog, where I share my passion for all the things I love, including programming, technology and so on."
>
  <meta
    slot="head"
    name="keywords"
    content="Jacky FAN, Blog, Personal Blog, Jacky FAN's Blog"
  />
  <div class="site-wrapper">
    <NavBar />
    <main id="main-content" class="site-main">
      <section class="site-section blog-hero">
        <div class="geo-circle geo-circle--lg"></div>
        <div class="geo-accent" style="top:60%;right:-100px;"></div>
        <div class="container">
          <h1 class="sr-only">Jacky FAN's Blog</h1>
          {featuredArticle && (
            <a href={buildArticlePath(featuredArticle.slug)} class="blog-hero__grid">
              <div class="blog-hero__content reveal">
                <span class="section-label">Latest Article</span>
                <h2 class="blog-hero__title">{featuredArticle.title}</h2>
                {featuredArticle.description && <p class="blog-hero__desc">{featuredArticle.description}</p>}
                <div class="blog-hero__meta">
                  {getPrimaryPayloadTag(featuredArticle.tags) && <span class="tag-pill">{getPrimaryPayloadTag(featuredArticle.tags)}</span>}
                  {featuredArticle.publishedDate && <span>{formatPayloadDate(featuredArticle.publishedDate)}</span>}
                  <span>·</span>
                  <span>{featuredArticle.readTime || 1} min read</span>
                </div>
              </div>
              <div class="blog-hero__image reveal">
                {getFeaturedImageUrl(featuredArticle) ? (
                  <img
                    src={getFeaturedImageUrl(featuredArticle)}
                    alt={getFeaturedImageAlt(featuredArticle)}
                    loading="eager"
                  />
                ) : (
                  <div class="blog-hero__placeholder"></div>
                )}
              </div>
            </a>
          )}
        </div>
      </section>

      <section class="site-section site-section--tinted">
        <div class="geo-circle geo-circle--md"></div>
        <div class="container">
          <span class="section-label reveal">Recent Articles</span>
          <h2 class="section-headline reveal">Latest Writing</h2>
          <p class="section-subtitle reveal">Notes on programming, dev tooling, self-hosting, and more.</p>

          <div class="article-grid reveal-stagger" style="margin-top: 3rem;">
            {recentArticles.map((article) => (
              <a href={buildArticlePath(article.slug)} class="article-card">
                <div class="article-card__image">
                  {getFeaturedImageUrl(article) ? (
                    <img
                      src={getFeaturedImageUrl(article)}
                      alt={getFeaturedImageAlt(article)}
                      loading="lazy"
                    />
                  ) : (
                    <div class="article-card__placeholder"></div>
                  )}
                </div>
                <div class="article-card__body">
                  <div class="article-card__meta">
                    {getPrimaryPayloadTag(article.tags) && <span class="tag-pill">{getPrimaryPayloadTag(article.tags)}</span>}
                    {article.publishedDate && <span>{formatPayloadDate(article.publishedDate)}</span>}
                  </div>
                  <h3 class="article-card__title">{article.title}</h3>
                  {article.description && <p class="article-card__excerpt">{article.description}</p>}
                </div>
              </a>
            ))}
          </div>

          <div class="show-more reveal">
            <a href="/articles" class="show-more__button">View all articles →</a>
          </div>
        </div>
      </section>

      <section class="site-section site-section--dark about-blurb">
        <div class="geo-circle geo-circle--lg" style="border-color:rgba(245,243,239,0.06);top:-80px;right:-80px;"></div>
        <div class="geo-accent" style="top:auto;bottom:-100px;right:-80px;"></div>
        <div class="container">
          <div class="about-blurb__inner reveal">
            <h2 class="about-blurb__title">{homeAbout?.title || "Hi, I'm Jacky"}</h2>
            <p class="about-blurb__text">{homeAbout?.body || 'A frontend developer based in Hong Kong. I write about web development, dev tooling, self-hosting, and the occasional hardware experiment.'}</p>
            <a href={homeAbout?.linkUrl || '/about'} class="about-blurb__link">{homeAbout?.linkText || 'More about me →'}</a>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</Base>
