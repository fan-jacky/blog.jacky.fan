---
import Base from '@/layouts/Base.astro'
import NavBar from '@/components/shared/NavBar.astro'
import Footer from '@/components/shared/Footer.astro'
import SlateRenderer from '@/components/content/SlateRenderer.astro'
import type { SlateNode } from '@/types/slate'
import { fetchPayloadAbout } from '@/lib/payload'

// Mirrors /api/payload-about (GET /api/globals/about).
const about = await fetchPayloadAbout()

const bodyNodes: SlateNode[] = about?.body ?? []
---

<Base
  title="About — Jacky FAN"
  description="About Jacky FAN — frontend developer based in Hong Kong."
>
  <div class="site-wrapper">
    <NavBar />
    <main id="main-content" class="site-main">
      <section class="site-section site-section--about about-page">
        <div class="geo-circle geo-circle--sm" style="top:15%;right:6%;"></div>
        <div class="container container--narrow">
          <span class="section-label reveal">About</span>
          <h1 class="section-headline reveal">Hi, I'm Jacky</h1>
          <p class="section-subtitle reveal">A frontend developer based in Hong Kong.</p>

          <div class="about-page__body reveal">
            {bodyNodes.length > 0 && <SlateRenderer nodes={bodyNodes} />}
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</Base>
