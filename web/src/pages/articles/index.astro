---
import Base from '@/layouts/Base.astro'
import NavBar from '@/components/shared/NavBar.astro'
import Footer from '@/components/shared/Footer.astro'
import type { PayloadPostSummary } from '@/types/payload'
import {
  buildArticlePath,
  formatPayloadDate,
  getPrimaryPayloadTag,
  parsePayloadTags,
  resolvePayloadMediaAlt,
  resolvePayloadMediaUrl,
} from '@/lib/payloadPost'
import { fetchPayloadPostsForBuild, getPayloadConnection, toPayloadPostSummary } from '@/lib/payload'

// Mirrors /api/payload-posts (depth 1, published only, sorted -publishedDate).
const articles = (await fetchPayloadPostsForBuild({ depth: 1 })).map(toPayloadPostSummary)

const categoryOptions = (() => {
  const uniqueTags = new Set<string>()

  for (const article of articles) {
    for (const tag of parsePayloadTags(article.tags)) {
      uniqueTags.add(tag)
    }
  }

  return Array.from(uniqueTags).sort((left, right) => left.localeCompare(right))
})()

// Build-time default view: no search, 'all' filter, 'newest' sort — the API's
// -publishedDate order already matches the Vue default state. Search, category
// and sort are applied client-side by the script below.
const filteredArticles = articles

// Media URLs are relative to the CMS origin when stored as relative paths.
// The public origin wins so browser-reachable URLs are emitted (same
// precedence as the Nuxt version: public.payloadUrl || payloadUrl).
const cmsBaseUrl = import.meta.env.PUBLIC_PAYLOAD_URL || getPayloadConnection().payloadURL

function getImageUrl(article: PayloadPostSummary): string {
  return resolvePayloadMediaUrl(article.featuredImage, cmsBaseUrl)
}

function getImageAlt(article: PayloadPostSummary): string {
  return resolvePayloadMediaAlt(article.title, article.featuredImage)
}
---

<Base
  title="All Articles — Jacky FAN"
  description="Browse all articles by Jacky FAN — filter by topic and search across the archive."
>
  <div class="site-wrapper">
    <NavBar />
    <main id="main-content" class="site-main">
      <section class="site-section site-section--listing">
        <div class="geo-circle geo-circle--sm" style="top:10%;right:8%;"></div>
        <div class="container">
          <div class="article-listing__header reveal">
            <span class="section-label">Browse</span>
            <h1 class="section-headline">All Articles</h1>
            <p class="section-subtitle">Browse the full archive — filter by topic or search by title and excerpt.</p>
          </div>

          <div class="article-listing__filters reveal">
            <div class="article-listing__filters-row">
              <div class="article-listing__search">
                <svg class="article-listing__search-icon" viewBox="0 0 16 16" fill="none"><circle cx="6.5" cy="6.5" r="5" stroke="currentColor" stroke-width="1.5"></circle><path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
                <label for="searchInput" class="sr-only">Search articles</label>
                <input id="searchInput" type="text" class="article-listing__input" placeholder="Search articles...">
              </div>
            </div>
            <div class="article-listing__filters-row">
              <div class="article-listing__group">
                <label class="article-listing__label" for="filterSelect">Category</label>
                <select id="filterSelect" class="article-listing__select">
                  <option value="all">All categories</option>
                  {categoryOptions.map((option) => (
                    <option value={option}>{option}</option>
                  ))}
                </select>
              </div>
              <div class="article-listing__group">
                <label class="article-listing__label" for="sortSelect">Sort</label>
                <select id="sortSelect" class="article-listing__select">
                  <option value="newest">Newest first</option>
                  <option value="oldest">Oldest first</option>
                  <option value="az">A → Z</option>
                </select>
              </div>
              <button type="button" class="article-listing__reset">Reset</button>
            </div>
          </div>

          <div class="article-listing__count reveal">{filteredArticles.length} articles</div>

          {filteredArticles.length > 0 && (
            <div class="article-list reveal">
              {filteredArticles.map((article) => (
                <a
                  href={buildArticlePath(article.slug)}
                  class="article-list-item"
                  data-title={article.title}
                  data-published-date={article.publishedDate ?? ''}
                  data-tags={article.tags ?? ''}
                  data-search={[article.title, article.description ?? '', article.tags ?? ''].join(' ').toLowerCase()}
                >
                  <div class="article-list-item__image">
                    {getImageUrl(article) ? (
                      <img src={getImageUrl(article)} alt={getImageAlt(article)} loading="lazy" />
                    ) : (
                      <div class="article-list-item__placeholder"></div>
                    )}
                  </div>
                  <div class="article-list-item__content">
                    <div class="article-list-item__meta">
                      {getPrimaryPayloadTag(article.tags) && <span class="tag-pill">{getPrimaryPayloadTag(article.tags)}</span>}
                      {article.publishedDate && <span>{formatPayloadDate(article.publishedDate)}</span>}
                      {article.readTime ? <span>·</span> : null}
                      {article.readTime ? <span>{article.readTime} min read</span> : null}
                    </div>
                    <h2 class="article-list-item__title">{article.title}</h2>
                    {article.description && <p class="article-list-item__excerpt">{article.description}</p>}
                  </div>
                </a>
              ))}
            </div>
          )}

          <p class="article-listing__empty reveal" style="display: none;">No articles match the current filters.</p>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</Base>

<script>
  const searchInput = document.getElementById('searchInput') as HTMLInputElement | null
  const filterSelect = document.getElementById('filterSelect') as HTMLSelectElement | null
  const sortSelect = document.getElementById('sortSelect') as HTMLSelectElement | null
  const resetButton = document.querySelector('.article-listing__reset') as HTMLButtonElement | null
  const articleList = document.querySelector('.article-list') as HTMLElement | null
  const countElement = document.querySelector('.article-listing__count') as HTMLElement | null
  const emptyMessage = document.querySelector('.article-listing__empty') as HTMLElement | null

  const items: HTMLElement[] = articleList
    ? Array.from(articleList.querySelectorAll<HTMLElement>('.article-list-item'))
    : []

  function applyFilters(): void {
    const query = (searchInput?.value ?? '').trim().toLowerCase()
    const activeFilter = filterSelect?.value ?? 'all'
    const activeSort = sortSelect?.value ?? 'newest'

    const matches = items.filter((item) => {
      const tags = (item.dataset.tags ?? '').split(',').map((tag) => tag.trim()).filter(Boolean)
      const matchesFilter = activeFilter === 'all' || tags.some((tag) => tag.toLowerCase() === activeFilter.toLowerCase())

      if (!matchesFilter) {
        return false
      }

      if (!query) {
        return true
      }

      return (item.dataset.search ?? '').includes(query)
    })

    const sorted = matches.sort((left, right) => {
      if (activeSort === 'az') {
        return (left.dataset.title ?? '').localeCompare(right.dataset.title ?? '')
      }

      const leftDate = left.dataset.publishedDate ?? ''
      const rightDate = right.dataset.publishedDate ?? ''

      return activeSort === 'oldest'
        ? leftDate.localeCompare(rightDate)
        : rightDate.localeCompare(leftDate)
    })

    for (const item of items) {
      item.style.display = 'none'
    }

    for (const item of sorted) {
      item.style.display = ''
      articleList?.appendChild(item)
    }

    if (articleList) {
      articleList.style.display = sorted.length > 0 ? '' : 'none'
    }

    if (emptyMessage) {
      emptyMessage.style.display = sorted.length > 0 ? 'none' : ''
    }

    if (countElement) {
      countElement.textContent = `${sorted.length} articles`
    }
  }

  function resetFilters(): void {
    if (searchInput) {
      searchInput.value = ''
    }
    if (filterSelect) {
      filterSelect.value = 'all'
    }
    if (sortSelect) {
      sortSelect.value = 'newest'
    }
    applyFilters()
  }

  searchInput?.addEventListener('input', applyFilters)
  filterSelect?.addEventListener('change', applyFilters)
  sortSelect?.addEventListener('change', applyFilters)
  resetButton?.addEventListener('click', resetFilters)
</script>
