# ── Astro frontend (web/) ─────────────────────────────────────────────────────
# Server-side (not exposed to the browser)
# Internal CMS URL, e.g. http://localhost:4101 (local) or http://cms:4201 (Docker)
PAYLOAD_URL=http://localhost:4101
# Payload API key used to fetch draft posts in preview mode
PAYLOAD_API_KEY=
# Shared secret validating /api/preview requests from the CMS
PREVIEW_SECRET=

# Client-side (exposed to the browser via import.meta.env.PUBLIC_*)
# Empty string = proxy mode: browser CMS calls go to same-origin /api/*
PUBLIC_PAYLOAD_URL=
# Google Analytics measurement ID (optional)
PUBLIC_GTAG_ID=
