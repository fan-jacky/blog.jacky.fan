{
  "name": "blog-cms",
  "version": "1.0.0",
  "description": "Payload CMS for blog.jacky.fan",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "postinstall": "npm rebuild sharp && cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --webpack -p 4101",
    "prebuild": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap && cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 4101",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:graphql": "payload generate:graphql"
  },
  "dependencies": {
    "@ckeditor/ckeditor5-react": "^12.0.0",
    "@payloadcms/db-mongodb": "^3.91.0",
    "@payloadcms/graphql": "3.91.0",
    "@payloadcms/next": "^3.91.0",
    "@payloadcms/richtext-slate": "^3.91.0",
    "@payloadcms/ui": "3.91.0",
    "ckeditor5": "^49.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.8",
    "express": "^4.22.2",
    "graphql": "^17.0.2",
    "next": "^16.4.2",
    "payload": "^3.91.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sass": "^1.106.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
