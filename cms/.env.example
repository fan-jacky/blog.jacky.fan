# Required: A long random string used to sign JWTs
PAYLOAD_SECRET=change-this-to-a-long-random-string

# MongoDB connection URI
DATABASE_URI=mongodb://localhost:27027/blog-cms

# Public URL of the CMS server. Leave blank in local/LAN setups so Payload uses
# the current request origin instead of hard-coding localhost into the admin app.
PAYLOAD_PUBLIC_SERVER_URL=

# Public URL of the Nuxt blog (used for preview links and CORS)
PAYLOAD_PUBLIC_SITE_URL=http://localhost:4100

# Additional blog origins allowed for CORS / CSRF (comma-separated)
PAYLOAD_PUBLIC_SITE_URLS=

# Secret shared with the Nuxt blog to authenticate preview requests
PREVIEW_SECRET=change-this-to-another-random-string

# Port the CMS server listens on
PORT=4101
